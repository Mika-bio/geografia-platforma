ро — Fe-Ni.","grade":9,"category":"халық","difficulty":"қиын"},{"id":"g9-q079","question":"Орографиялық жауын қайда?","options":["Тек жазықта әрқашан","Таудың жел жақ беткейінде","Тек полюсте ғана","Тек мұхит түбінде"],"answer":1,"explanation":"Тау беткейінде.","grade":9,"category":"экономика","difficulty":"оңай"},{"id":"g9-q080","question":"ҚР ірі теміржол торабының маңызы?","options":["Тек әшекей","Жүк пен жолаушы тасымалы","Тек спорт","Тек ойын"],"answer":1,"explanation":"Көлік байланысы.","grade":9,"category":"Қазақстан","difficulty":"орта"},{"id":"g9-q081","question":"Жердің ең қатты сыртқы қабаты?","options":["Гидросфера","Литосфера","Атмосфера","Биосфера"],"answer":1,"explanation":"Литосфера — қатты қабық.","grade":9,"category":"аймақ","difficulty":"қиын"},{"id":"g9-q082","question":"Экватор ендігі?","options":["90°","0°","180°","45°"],"answer":1,"explanation":"Экватор — 0°.","grade":9,"category":"экология","difficulty":"оңай"},{"id":"g9-q083","question":"Масштаб 1:50 000 — 2 см нақтыда?","options":["0.5 км","1 км","2 км","5 км"],"answer":1,"explanation":"1 см=0.5 км → 2 см=1 км.","grade":9,"category":"жаһан","difficulty":"орта"},{"id":"g9-q084","question":"Қазақстанның ең үлкен көлі (ішінара)?","options":["Иссык-Көл","Балқаш","Байкал","Виктория"],"answer":1,"explanation":"Балқаш — Қазақстандағы ірі көл.","grade":9,"category":"саяси","difficulty":"қиын"},{"id":"g9-q085","question":"Континенттік климатқа тән?","options":["Жұмсақ қыс","Үлкен температура амплитудасы","Жыл бойы бірдей жауын","Тек тропик"],"answer":1,"explanation":"Континенттікте амплитуда үлкен.","grade":9,"category":"халық","difficulty":"оңай"},{"id":"g9-q086","question":"Субдукция дегеніміз?","options":["Тақтаның ажырауы","Бір тақтаның екіншісінің астына кіруі","Тек жел","Тек жаңбыр"],"answer":1,"explanation":"Субдукция — тақтаның төмен енуі.","grade":9,"category":"экономика","difficulty":"орта"},{"id":"g9-q087","question":"Пассаттар қай ендікте?","options":["Полюсте","Тропиктік ендіктерде","Те