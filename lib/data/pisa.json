[{"id":"pisa-water-kz","title":"Қазақстандағы су тапшылығы","situation":"Оңтүстік Қазақстандағы ауылда жаз айларында ауыз су мен суару суы жетіспейді. Өзен деңгейі төмендеген, егістік алқабы кеңейген, халық саны өскен.","text":"Соңғы 10 жылда өңірдегі су тұтыну 25%-ға артты. Жауын-шашын орташа жылдық мөлшері 280 мм. Тамшылатып суару үлесі небәрі 12%.","visual":{"kind":"chart","title":"Су тұтыну мен жауын (шартты)","bars":[{"label":"2015 тұтыну","value":100},{"label":"2025 тұтыну","value":125},{"label":"Жауын индексі","value":70}]},"questions":[{"id":"w1","prompt":"Су тапшылығының негізгі себептерінің бірі?","options":["Тек жанартау","Тұтынудың артуы және шектеулі жауын","Тек желдің тоқтауы","Тек карта қатесі"],"answer":1,"feedback":"Сұраныс өсіп, ұсыныс шектеулі."},{"id":"w2","prompt":"Қандай дәлел су стрессін растайды?","options":["Тұтыну +25% және жауын 280 мм","Тек ән мәтіні","Тек спорт нәтижесі","Ешқандай дерек жоқ"],"answer":0,"feedback":"Сандық дерек — дәлел."},{"id":"w3","prompt":"Ең ұтымды шара?","options":["Суды ысырап ету","Тамшылатып суаруды кеңейту және үнемдеу","Егістікті шексіз ұлғайту","Мониторингті тоқтату"],"answer":1,"feedback":"Үнемді технологиялар."},{"id":"w4","prompt":"Ұзақ мерзімді қорытынды:","options":["Мәселе өздігінен шешіледі","Басқарусыз су балансы нашарлауы мүмкін","Жауын міндетті түрде артады","Су маңызсыз"],"answer":1,"feedback":"Басқару қажет."}]},{"id":"pisa-climate-city","title":"Үш қала климаты","situation":"Оқушылар Алматы, Астана және Ақтау климатын салыстырады.","text":"Алматы — 650 мм, Астана — 320 мм, Ақтау — 150 мм жауын. Температура амплитудасы Астанада ең үлкен.","visual":{"kind":"chart","title":"Жылдық жауын-шашын (мм)","bars":[{"label":"Алматы","value":650},{"label":"Астана","value":320},{"label":"Ақтау","value":150}]},"questions":[{"id":"c1","prompt":"Қай қала құрғақтау?","options":["Алматы","Астана","Ақтау","Бірдей"],"answer":2,"feedback":"Ақтау — 150 мм."},{"id":"c2","prompt":"Алматыдағы жоғары жауынның ықтимал себебі?","options":["Тек саясат","Тауға жақындық / орография","Тек мұхит ағысы міндетті","Тек кездейсоқтық"],"answer":1,"feedback":"Орографиялық жауын."},{"id":"c3","prompt":"Ауыл шаруашылығы үшін су бойынша қолайлырақ?","options":["Ақтау","Алматы","Тек шөл","Ешқайсысы"],"answer":1,"feedback":"Көбірек жауын."}]},{"id":"pisa-river-regime","title":"Тау өзенінің режимі","situation":"Тау өзені мұздық пен қармен қоректенеді. Төменде айлық шығын берілген.","text":"Қаңтар 20, сәуір 80, шілде 150, қазан 40 м³/с.","visual":{"kind":"line","title":"Өзен шығыны","points":[{"label":"Қаң","value":20},{"label":"Сәу","value":80},{"label":"Шіл","value":150},{"label":"Қаз","value":40}]},"questions":[{"id":"r1","prompt":"Максимум қайда?","options":["Қаңтар","Сәуір","Шілде","Қазан"],"answer":2,"feedback":"Жазда мұздық еріуі."},{"id":"r2","prompt":"Көктемгі өсу себебі?","options":["Тек жел","Қардың еруі","Тек тұман","Тек сілкініс"],"answer":1,"feedback":"Қар еруі."},{"id":"r3","prompt":"Мұздық кішірейсе жазғы шығын?","options":["Міндетті өседі","Ұзақ мерзімде төмендеуі мүмкін","Өзгермейді","Тек қыста өседі"],"answer":1,"feedback":"Қор азаяды."}]},{"id":"pisa-map-scale","title":"Карта масштабы және тәуекел","situation":"Су тасқыны қаупін бағалау үшін екі карта қолданылады.","text":"А картасы 1:25 000, В картасы 1:1 000 000. Өзен бойындағы ауылдарды анықтау керек.","visual":{"kind":"table","title":"Карта салыстыруы","headers":["Карта","Масштаб","Деталь"],"rows":[["А","1:25 000","жоғары"],["В","1:1 000 000","төмен"]]},"questions":[{"id":"m1","prompt":"Ауыл мен жолды толығырақ көру үшін?","options":["В","А","Екеуі бірдей","Ешқайсысы"],"answer":1,"feedback":"Ірі масштаб."},{"id":"m2","prompt":"Бүкіл елді шолу үшін?","options":["А","В","Тек фото","Тек глобус міндетті"],"answer":1,"feedback":"Ұсақ масштаб."},{"id":"m3","prompt":"А картасында 4 см = ?","options":["0.5 км","1 км","4 км","25 км"],"answer":1,"feedback":"1 см=0.25 км → 4 см=1 км."}]},{"id":"pisa-seismic","title":"Сейсмикалық қауіп","situation":"Алматы маңында сілкініс қаупі жоғары. Мектеп жаттығу өткізеді.","text":"Эпицентрлер Тянь-Шань белдеуінде шоғырланған. Жазық орталықта белсенділік төменірек.","visual":{"kind":"map","title":"Сейсмикалық белдеу (схема)","note":"Тау белдеуі — жоғары қауіп; жазық — төменірек"},"questions":[{"id":"s1","prompt":"Сілкініс шоғыры немен түсіндіріледі?","options":["Тек климат","Тақта шекаралары / тау құрылысы","Тек өзен","Тек халық саны"],"answer":1,"feedback":"Тектоника."},{"id":"s2","prompt":"Практикалық ұсыныс?","options":["Нормаларды елемеу","Сейсмикаға төзімді құрылыс және дайындық","Тек көшу міндетті","Тек жаңбырдан қорғану"],"answer":1,"feedback":"Дайындық маңызды."},{"id":"s3","prompt":"Дәлел ретінде не жарайды?","options":["Эпицентр картасы","Тек ән","Тек өсек","Тек түс таңдау"],"answer":0,"feedback":"Карта — дәлел."}]},{"id":"pisa-population","title":"Халық және ресурстар","situation":"Аймақ А: тығыздық жоғары, су аз. Аймақ Б: тығыздық төмен, су көп.","text":"Екеуі де құрғақ белдеуде орналасқан, бірақ су жүктемесі әртүрлі.","visual":{"kind":"table","title":"Салыстыру","headers":["Аймақ","Тығыздық","Су"],"rows":[["А","жоғары","төмен"],["Б","төмен","жоғары"]]},"questions":[{"id":"p1","prompt":"Су стрессі қайда өткір?","options":["Б","А","Бірдей","Анықталмайды"],"answer":1,"feedback":"А — жоғары сұраныс."},{"id":"p2","prompt":"Тұрақты шешім?","options":["Шексіз тұтыну","Үнемдеу және тиімді технология","Тек жаңа өзен қазу","Ештеңе"],"answer":1,"feedback":"Үнемдеу."}]}]