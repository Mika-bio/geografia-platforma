[{"id":"ol-L1-1","level":1,"levelLabel":"І базалық","type":"map","question":"Қазақстанның физикалық картасында Қаратау жотасы қай өңірге жатады?","options":["Солтүстік жазық","Оңтүстік Қазақстан","Тек Каспий аралдары","Тек Алтай мұздығы ғана"],"answer":1,"explanation":"Қаратау — оңтүстікте."},{"id":"ol-L1-2","level":1,"levelLabel":"І базалық","type":"coordinates","question":"Нүкте: 43°N, 77°E. Бұл шамамен қай қала маңы?","options":["Ақтау","Алматы","Петропавл","Орал"],"answer":1,"explanation":"Алматы шамамен 43°N, 77°E."},{"id":"ol-L1-3","level":1,"levelLabel":"І базалық","type":"scale","question":"Масштаб 1:250 000. Картада 8 см — нақты қашықтық?","options":["8 км","20 км","25 км","40 км"],"answer":1,"explanation":"1 см=2.5 км → 8×2.5=20 км."},{"id":"ol-L1-4","level":1,"levelLabel":"І базалық","type":"distance","question":"Екі нүкте арасы картада 5 см, масштаб 1:500 000. Қашықтық?","options":["10 км","25 км","50 км","5 км"],"answer":1,"explanation":"1 см=5 км → 25 км."},{"id":"ol-L1-5","level":1,"levelLabel":"І базалық","type":"timezones","question":"Бойлық айырмасы 30°. Уақыт айырмасы шамамен?","options":["0.5 сағ","2 сағ","5 сағ","12 сағ"],"answer":1,"explanation":"15° ≈ 1 сағ → 30° ≈ 2 сағ."},{"id":"ol-L1-6","level":1,"levelLabel":"І базалық","type":"climate","question":"Климатограммада шілде +24°C, қаңтар −18°C, жауын 280 мм. Климат типі?","options":["Экваторлық","Континенттік","Теңіздік тропиктік","Муссондық ылғал"],"answer":1,"explanation":"Үлкен амплитуда + аз жауын = континенттік.","chart":{"months":["Қаң","Сәу","Шіл","Қаз"],"temp":[-15,8,24,6],"precip":[20,30,15,25]}},{"id":"ol-L1-7","level":1,"levelLabel":"І базалық","type":"table","question":"Кесте: Аймақ А жауын 600 мм, Б 150 мм. Қайсысында суару қажеттілігі жоғары?","options":["А","Б","Бірдей","Ешқайсысы"],"answer":1,"explanation":"Аз жауын → суару керек.","table":{"headers":["Аймақ","Жауын, мм","Халық"],"rows":[["А","600","жоғары"],["Б","150","орта"]]}},{"id":"ol-L2-8","level":2,"levelLabel":"ІІ күрделі","type":"compare","question":"Батыс ҚР мен Солтүстік ҚР ресурстарын салыстырыңыз. Дұрыс:","options":["Екеуі де тек туризм","Батыс — мұнай-газ; Солтүстік — астық","Екеуі де тек мұздық","Айырма жоқ"],"answer":1,"explanation":"Мамандану әртүрлі."},{"id":"ol-L2-9","level":2,"levelLabel":"ІІ күрделі","type":"cause-effect","question":"Себеп: мұздықтар кішірейді. Салдар?","options":["Жазғы өзен ағыны ұзақ мерзімде азаюы мүмкін","Тек жауын артады міндетті","Тек тау жоғалады бірден","Ешқандай әсер жоқ"],"answer":0,"explanation":"Мұздық қоректенуі азаяды."},{"id":"ol-L2-10","level":2,"levelLabel":"ІІ күрделі","type":"multi-correct","question":"Қайсылары эндогенді процеске жатады? (ең толық жауап)","options":["Тек жел","Тақта қозғалысы және жанартау","Тек жаңбыр","Тек топырақ эрозиясы ғана"],"answer":1,"explanation":"Эндогенді — ішкі күштер."},{"id":"ol-L2-11","level":2,"levelLabel":"ІІ күрделі","type":"logic","question":"Егер изобаралар тығыз болса және циклон жақындаса, не күтіледі?","options":["Тыныш антициклон","Күшті жел және бұлтты/жауынды ауа райы","Тек құрғақ штиль","Тек топырақ түзілуі"],"answer":1,"explanation":"Тығыз изобара + циклон → жел/жауын."},{"id":"ol-L2-12","level":2,"levelLabel":"ІІ күрделі","type":"map","question":"Дүниежүзі картасында Гольфстрим қай мұхитта?","options":["Үнді","Атлант","Солтүстік Мұзды ғана","Тек Каспий"],"answer":1,"explanation":"Гольфстрим — Атлант."},{"id":"ol-L1-13","level":1,"levelLabel":"І базалық","type":"coordinates","question":"Оңтүстік жарты шарда ендік қалай белгіленеді?","options":["N","S","E","W"],"answer":1,"explanation":"S — south."},{"id":"ol-L1-14","level":1,"levelLabel":"І базалық","type":"scale","question":"Ірі масштабты картаға мысал?","options":["1:10 000 000","1:25 000","1:50 000 000","1:100 000 000"],"answer":1,"explanation":"1:25 000 — ірі масштаб."},{"id":"ol-L2-15","level":2,"levelLabel":"ІІ күрделі","type":"distance","question":"Нақты 40 км. Масштаб 1:200 000. Картадағы ұзындық?","options":["2 см","20 см","40 см","5 см"],"answer":1,"explanation":"1 см=2 км → 40/2=20 см."},{"id":"ol-L2-16","level":2,"levelLabel":"ІІ күрделі","type":"timezones","question":"Шығысқа қарай 4 сағаттық белдеу айырмасы болса, бойлық айырмасы шамамен?","options":["15°","60°","4°","90°"],"answer":1,"explanation":"4×15°=60°."},{"id":"ol-L2-17","level":2,"levelLabel":"ІІ күрделі","type":"climate","question":"Диаграмма: жыл бойы жоғары T, жауын >2000 мм. Зона?","options":["Арктика","Экваторлық ылғалды орман","Шөл","Тундра"],"answer":1,"explanation":"Ылғалды ыстық = экваторлық.","chart":{"months":["Қаң","Сәу","Шіл","Қаз"],"temp":[-15,8,24,6],"precip":[20,30,15,25]}},{"id":"ol-L2-18","level":2,"levelLabel":"ІІ күрделі","type":"table","question":"Кесте: ел А — халық тығыздығы 300, су/адам төмен; ел Б — тығыздық 10, су жоғары. Су стрессі?","options":["Б жоғары","А жоғары","Бірдей","Жоқ"],"answer":1,"explanation":"Жоғары тығыздық+аз су=стресс.","table":{"headers":["Аймақ","Жауын, мм","Халық"],"rows":[["А","600","жоғары"],["Б","150","орта"]]}},{"id":"ol-L3-19","level":3,"levelLabel":"ІІІ олимпиадалық","type":"compare","question":"Балқаш пен Каспийді салыстыруда дұрыс:","options":["Екеуі де тұщы мұхит","Каспий — дүниежүзіндегі ең үлкен тұйық суайдын; Балқаш — ішінара тұщы/тұзды","Екеуі де Атлант шығанағы","Айырма жоқ"],"answer":1,"explanation":"Каспий тұйық; Балқаш ерекше тұздылық."},{"id":"ol-L3-20","level":3,"levelLabel":"ІІІ олимпиадалық","type":"cause-effect","question":"Үндістан тақтасының Еуразиямен соқтығысуының Қазақстанға әсері?","options":["Ешқандай","Тянь-Шаньның көтерілуі және сейсмикалық белсенділік","Тек жауын артуы ғана","Тек мұхит пайда болуы"],"answer":1,"explanation":"Коллизия → Тянь-Шань/сейсмика."},{"id":"ol-L3-21","level":3,"levelLabel":"ІІІ олимпиадалық","type":"multi-correct","question":"Су тапшылығын жеңілдететін шаралар жиыны:","options":["Суды шексіз ысырап ету","Үнемдеу, тамшылатып суару, қайта пайдалану, мониторинг","Тек жаңа шөл ашу","Тек орманды кесу"],"answer":1,"explanation":"Кешенді үнемдеу шаралары."},{"id":"ol-L3-22","level":3,"levelLabel":"ІІІ олимпиадалық","type":"logic","question":"Егер жылы ағыс жағалауды жуса, климатқа әсер?","options":["Әсер жоқ","Жағалау жылынып, ылғалдануы мүмкін","Тек құрғақ шөл міндетті","Тек полюс пайда болады"],"answer":1,"explanation":"Жылы ағыс климатты жұмсартады."},{"id":"ol-L3-23","level":3,"levelLabel":"ІІІ олимпиадалық","type":"map","question":"Дүниежүзілік сейсмикалық белдеулер негізінен қайда?","options":["Тек жазық орталықтарда","Литосфералық тақта шекараларында","Тек бір қалада","Тек шөлде ғана"],"answer":1,"explanation":"Тақта шекаралары."},{"id":"ol-L3-24","level":3,"levelLabel":"ІІІ олимпиадалық","type":"climate","question":"Ық беткейде жауын аз болуының логикасы?","options":["Ауа көтеріліп суымайды","Ауа төмендеп жылынып, құрғайды (фён әсері)","Тек карта қатесі","Тек ай әсері"],"answer":1,"explanation":"Ық беткей — құрғақ.","chart":{"months":["Қаң","Сәу","Шіл","Қаз"],"temp":[-15,8,24,6],"precip":[20,30,15,25]}},{"id":"ol-L3-25","level":3,"levelLabel":"ІІІ олимпиадалық","type":"table","question":"Ресурс кестесі: өңірде көмір көп, су аз, халық орташа. Қандай тәуекел жоғары?","options":["Тек мұздық өсуі","Су стрессі және экологиялық жүктеме","Тек тропиктік циклон ғана","Ешқандай"],"answer":1,"explanation":"Аз су + өнеркәсіп = стресс.","table":{"headers":["Аймақ","Жауын, мм","Халық"],"rows":[["А","600","жоғары"],["Б","150","орта"]]}},{"id":"ol-L1-26","level":1,"levelLabel":"І базалық","type":"coordinates","question":"Ендік 90°S — қай нүкте?","options":["Экватор","Оңтүстік полюс","Солтүстік полюс","Гринвич"],"answer":1,"explanation":"90°S — Оңтүстік полюс."},{"id":"ol-L2-27","level":2,"levelLabel":"ІІ күрделі","type":"distance","question":"Үш кесінді: 3 см+4 см+5 см, масштаб 1:100 000. Жол ұзындығы?","options":["6 км","12 км","100 км","3 км"],"answer":1,"explanation":"12 см × 1 км = 12 км."},{"id":"ol-L2-28","level":2,"levelLabel":"ІІ күрделі","type":"cause-effect","question":"Орман жойылса, беткейде не күшейеді?","options":["Топырақ тұрақтылығы артады","Эрозия және топырақ шайылуы","Тек жауын тоқтайды","Тек магма шығады"],"answer":1,"explanation":"Ормансыз эрозия күшейеді."},{"id":"ol-L3-29","level":3,"levelLabel":"ІІІ олимпиадалық","type":"logic","question":"PISA стилі: карта+кесте бойынша су тапшы аймақта мақта егістігі кеңейсе, ұзақ мерзімде?","options":["Су балансы жақсарады міндетті","Су ресурстарына қысым артуы мүмкін","Ешқандай өзгеріс болмайды","Тек жауын артады автоматты"],"answer":1,"explanation":"Суды көп қажет ететін дақыл қысымды арттырады."},{"id":"ol-L2-30","level":2,"levelLabel":"ІІ күрделі","type":"compare","question":"Мұхиттық және континенттік климатты салыстыру:","options":["Бірдей амплитуда","Мұхиттық — кіші амплитуда; континенттік — үлкен","Континенттік әрқашан ылғалдырақ","Айырма жоқ"],"answer":1,"explanation":"Амплитуда — негізгі айырма."},{"id":"ol-L3-x1","level":3,"levelLabel":"ІІІ олимпиадалық","type":"multi-correct","question":"Қазақстанның экологиялық мәселелеріне жататындар (ең толық):","options":["Тек орман өсуі","Арал тартылуы, Семей зардабы, су тапшылығы","Тек жауын артуы","Тек туризм өсуі"],"answer":1,"explanation":"Кешенді экологиялық мәселелер."},{"id":"ol-L3-x2","level":3,"levelLabel":"ІІІ олимпиадалық","type":"logic","question":"Егер карта масштабы кішірейсе (1:25k → 1:1M), деталь қалай өзгереді?","options":["Артады","Азаяды","Өзгермейді","Тек түс өзгереді"],"answer":1,"explanation":"Ұсақ масштабта деталь азаяды."},{"id":"ol-L3-x3","level":3,"levelLabel":"ІІІ олимпиадалық","type":"cause-effect","question":"Шөлдегі артық суарудың салдар тізбегі?","options":["Тек орман өседі","Тұздану → өнімділік төмендеуі","Тек жауын артады","Ешқандай әсер"],"answer":1,"explanation":"Артық суару тұздануға әкелуі мүмкін."},{"id":"ol-L3-x4","level":3,"levelLabel":"ІІІ олимпиадалық","type":"table","question":"Кесте: өңірде мұнай көп, су аз, халық өсуде. Басым тәуекел?","options":["Тек мұздық","Су және экологиялық жүктеме","Тек тропик","Ешқандай"],"answer":1,"explanation":"Су+өсу=жүктеме.","table":{"headers":["Фактор","Мән"],"rows":[["Мұнай","жоғары"],["Су","төмен"],["Халық","өсуде"]]}},{"id":"ol-L3-x5","level":3,"levelLabel":"ІІІ олимпиадалық","type":"climate","question":"Климат диаграммасында қыс өте суық, жаз ыстық, жауын аз. Қорытынды?","options":["Экваторлық","Құрғақ континенттік","Теңіздік","Муссондық ылғал"],"answer":1,"explanation":"Үлкен амплитуда+аз жауын.","chart":{"months":["Қаң","Сәу","Шіл","Қаз"],"temp":[-20,5,26,4],"precip":[15,20,12,18]}}]